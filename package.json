{
    "name": "git-strata",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.2",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "concurrently -n app,proxy -c cyan,magenta --kill-others-on-fail 'pnpm dev:app' 'pnpm dev:cors-proxy'",
        "dev:app": "vite dev",
        "dev:cors-proxy": "pnpm -C cors-proxy dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "knip": "knip"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "concurrently": "10.0.6",
        "eslint": "^10.13.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "knip": "^6.41.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-plugin-devtools-json": "^1.1.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@isomorphic-git/lightning-fs": "^4.10.3",
        "@logtape/logtape": "^2.4.1",
        "buffer": "^6.0.3",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "chartjs-plugin-zoom": "^2.2.0",
        "comlink": "^4.4.2",
        "date-fns": "^4.4.0",
        "idb": "^8.0.4",
        "isomorphic-git": "^1.44.3"
    },
    "engines": {
        "pnpm": ">=11"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
